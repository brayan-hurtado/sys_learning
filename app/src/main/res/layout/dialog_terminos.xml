<?xml version="1.0" encoding="utf-8"?>
<!--
    Ventana de términos y condiciones que se muestra antes de crear la
    cuenta (registro.kt). El texto completo está en res/raw/terminos_condiciones.html.

    Estructura:
      1. Encabezado con el degradado de la app
      2. Resumen en 3 puntos
      3. Texto completo con barra de lectura
      4. Casillas de aceptación en tarjetas (se habilitan al terminar de leer)
      5. Botones
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 1. Encabezado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_terminos_encabezado"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingEnd="20dp"
            android:paddingBottom="18dp">

            <TextView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_terminos_icono"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:text="🛡️"
                android:textSize="24sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Términos y condiciones"
                    android:textColor="@android:color/white"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvVersionTerminos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Última actualización: 2 de noviembre de 2026"
                    android:textColor="#D6E8FF"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Barra de lectura: avanza al desplazar el texto -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progresoLectura"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            app:indicatorColor="#42C8F5"
            app:trackColor="#E3E8F0"
            app:trackThickness="4dp" />

        <!-- 2 a 4: resumen, texto completo y casillas, en un solo bloque desplazable -->
        <ScrollView
            android:id="@+id/scrollTerminos"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fadeScrollbars="false"
            android:scrollbars="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="16dp"
                android:paddingEnd="18dp"
                android:paddingBottom="16dp">

                <!-- 2. Resumen -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_terminos_resumen"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="En pocas palabras"
                        android:textColor="#1565C0"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="📚  Sys Learning es una herramienta educativa de apoyo."
                        android:textColor="@color/texto_card"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="🔒  Tus datos se tratan según la Ley 1581 de 2012."
                        android:textColor="@color/texto_card"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="✉️  Puedes consultar, corregir o pedir que se borren tus datos."
                        android:textColor="@color/texto_card"
                        android:textSize="13sp" />

                </LinearLayout>


                <TextView
                    android:id="@+id/tvTextoTerminos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/sys_text"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Para continuar, confirma:"
                    android:textColor="@color/tituloCurso"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardCheckTerminos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:alpha="0.5"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#E3E8F0"
                    app:strokeWidth="1dp">

                    <CheckBox
                        android:id="@+id/cbAceptoTerminos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:enabled="false"
                        android:paddingTop="10dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="10dp"
                        android:text="He leído y acepto los términos y condiciones de uso de Sys Learning."
                        android:textColor="@color/sys_text"
                        android:textSize="14sp" />

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardCheckDatos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:alpha="0.5"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#E3E8F0"
                    app:strokeWidth="1dp">

                    <CheckBox
                        android:id="@+id/cbAutorizoDatos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:enabled="false"
                        android:paddingTop="10dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="10dp"
                        android:text="Autorizo de manera previa, expresa e informada el tratamiento de mis datos personales conforme a la Política de Tratamiento de Datos Personales de Sys Learning."
                        android:textColor="@color/sys_text"
                        android:textSize="14sp" />

                </com.google.android.material.card.MaterialCardView>

                <!-- Solo se muestra si la fecha de nacimiento indica que es menor de edad -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardCheckRepresentante"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:alpha="0.5"
                    android:visibility="gone"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#E3E8F0"
                    app:strokeWidth="1dp">

                    <CheckBox
                        android:id="@+id/cbAutorizacionRepresentante"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:enabled="false"
                        android:paddingTop="10dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="10dp"
                        android:text="Soy menor de edad y cuento con la autorización de mi representante legal para registrarme."
                        android:textColor="@color/sys_text"
                        android:textSize="14sp" />

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </ScrollView>

        <!-- 5. Barra inferior fija -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E3E8F0" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="10dp"
            android:paddingEnd="18dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/tvAvisoLectura"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Lee hasta el final para poder aceptar · 0 %"
                android:textColor="@color/sys_text_secondary"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAceptarTerminos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:enabled="false"
                android:minHeight="52dp"
                android:text="Aceptar y crear cuenta"
                android:textAllCaps="false"
                android:textSize="16sp"
                app:backgroundTint="@color/tituloCurso"
                app:cornerRadius="26dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRechazarTerminos"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No acepto"
                android:textAllCaps="false"
                android:textColor="@color/sys_text_secondary" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
