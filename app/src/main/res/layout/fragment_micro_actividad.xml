<?xml version="1.0" encoding="utf-8"?>
<!--
    Sesión de micro actividad (MicroActividadFragment): 7 pasos.
    La teoría (pasos 1 a 3) usa vista_teoria_actividad.xml; los ejercicios
    se arman en código dentro de contenedorPaso.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true">

    <!-- Pasos 4 a 7: ejercicios, retroalimentación y recompensa -->
    <LinearLayout
        android:id="@+id/contenedorEjercicios"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F5F7FA"
        android:orientation="vertical">

    <!-- Barra superior: salir + progreso de los 7 pasos + XP -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#143C8A"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/btnSalirMicro"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Salir de la actividad"
            android:gravity="center"
            android:text="✕"
            android:textColor="@android:color/white"
            android:textSize="20sp" />

        <ProgressBar
            android:id="@+id/progresoPasos"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="10dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:max="7"
            android:progress="0"
            android:progressDrawable="@drawable/progress_horizontal" />

        <TextView
            android:id="@+id/tvXpMicro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⭐ 0 XP"
            android:textColor="#FFD54F"
            android:textStyle="bold" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvPasoMicro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#E8EEF8"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp"
        android:text="Paso 1 de 7 · Presentar el reto"
        android:textColor="#143C8A"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvVistaPrevia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFF3E0"
        android:gravity="center"
        android:padding="6dp"
        android:text="Vista previa del administrador: no se registran resultados"
        android:textColor="#B26A00"
        android:textSize="12sp"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/scrollMicro"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/contenedorPaso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp" />

    </ScrollView>

    <!-- Paso 5: retroalimentación inmediata -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardRetro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:visibility="gone"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvRetroTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRetroMensaje"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="2dp"
                android:maxLines="8"
                android:scrollbars="vertical"
                android:textColor="@color/sys_text"
                android:textSize="14sp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPrincipalMicro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:minHeight="56dp"
        android:text="Continuar"
        android:textAllCaps="false"
        android:textSize="16sp"
        app:backgroundTint="#143C8A"
        app:cornerRadius="16dp" />

</LinearLayout>

    <!-- Pasos 1 a 3: teoría, con el diseño de fragment_contenido -->
    <include
        android:id="@+id/contenedorTeoria"
        layout="@layout/vista_teoria_actividad"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</FrameLayout>
