<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"

    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"

        android:padding="10dp">

        <LinearLayout

            android:id="@+id/itemDashboard"

            android:layout_width="match_parent"

            android:layout_height="55dp"

            android:layout_marginBottom="8dp"

            android:gravity="center_vertical"

            android:paddingHorizontal="16dp"

            android:background="@drawable/menu_item_selector"

            android:clickable="true"

            android:focusable="true">

            <ImageView

                android:layout_width="24dp"

                android:layout_height="24dp"

                android:src="@drawable/ic_dashboard"

                android:tint="#143C8A"/>

            <TextView

                android:layout_width="wrap_content"

                android:layout_height="wrap_content"

                android:text="Dashboard"

                android:textSize="17sp"

                android:textColor="#233142"

                android:layout_marginStart="16dp"/>

        </LinearLayout>

        <LinearLayout

            android:id="@+id/itemCursos"

            android:layout_width="match_parent"

            android:layout_height="55dp"

            android:layout_marginBottom="8dp"

            android:gravity="center_vertical"

            android:paddingHorizontal="16dp"

            android:background="@drawable/menu_item_selector"

            android:clickable="true"

            android:focusable="true">

            <ImageView

                android:layout_width="24dp"

                android:layout_height="24dp"

                android:src="@drawable/ic_school"

                android:tint="#143C8A"/>

            <TextView


                android:layout_width="wrap_content"

                android:layout_height="wrap_content"

                android:text="Cursos"

                android:textSize="17sp"

                android:textColor="#233142"

                android:layout_marginStart="16dp"/>

        </LinearLayout>


        <LinearLayout

            android:id="@+id/itemAulas"

            android:layout_width="match_parent"

            android:layout_height="55dp"

            android:layout_marginBottom="8dp"

            android:gravity="center_vertical"

            android:paddingHorizontal="16dp"

            android:background="@drawable/menu_item_selector"

            android:clickable="true"

            android:focusable="true">

            <ImageView

                android:layout_width="24dp"

                android:layout_height="24dp"

                android:src="@drawable/ic_module"

                android:tint="#143C8A"/>

            <TextView

                android:layout_width="wrap_content"

                android:layout_height="wrap_content"

                android:text="Aulas"

                android:textSize="17sp"

                android:textColor="#233142"

                android:layout_marginStart="16dp"/>

        </LinearLayout>


        <LinearLayout

            android:id="@+id/itemActividades"

            android:layout_width="match_parent"

            android:layout_height="55dp"

            android:layout_marginBottom="8dp"

            android:gravity="center_vertical"

            android:paddingHorizontal="16dp"

            android:background="@drawable/menu_item_selector"

            android:clickable="true"

            android:focusable="true">

            <ImageView

                android:layout_width="24dp"

                android:layout_height="24dp"

                android:src="@drawable/ic_actividades"

                android:tint="#143C8A"/>

            <TextView

                android:layout_width="wrap_content"

                android:layout_height="wrap_content"

                android:text="Actividades"

                android:textSize="17sp"

                android:textColor="#233142"

                android:layout_marginStart="16dp"/>

        </LinearLayout>

        <LinearLayout

            android:id="@+id/itemEstadisticas"

            android:layout_width="match_parent"

            android:layout_height="55dp"

            android:layout_marginBottom="8dp"

            android:gravity="center_vertical"

            android:paddingHorizontal="16dp"

            android:background="@drawable/menu_item_selector"

            android:clickable="true"

            android:focusable="true">

            <ImageView

                android:layout_width="24dp"

                android:layout_height="24dp"

                android:src="@drawable/ic_estadisticas"

                android:tint="#143C8A"/>

            <TextView

                android:layout_width="wrap_content"

                android:layout_height="wrap_content"

                android:text="estadisticas"

                android:textSize="17sp"

                android:textColor="#233142"

                android:layout_marginStart="16dp"/>

        </LinearLayout>



        <LinearLayout

            android:id="@+id/itemUsuarios"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:background="@drawable/menu_item_selector"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_people"
                android:tint="#143C8A"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Usuarios"
                android:textSize="17sp"
                android:textColor="#233142"
                android:layout_marginStart="16dp"/>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:background="#DDDDDD"/>

        <LinearLayout
            android:id="@+id/btnCerrarSesion"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:background="@drawable/menu_logout_selector"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_logout"
                android:tint="#D32F2F"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Cerrar sesión"
                android:textColor="#D32F2F"
                android:textSize="17sp"
                android:fontFamily="sans-serif-medium"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>