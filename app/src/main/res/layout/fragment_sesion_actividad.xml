<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121213"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Barra superior: salir + progreso de la sesión + XP -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnSalirSesion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:text="✕"
            android:textColor="@android:color/white"
            android:textSize="20sp" />

        <ProgressBar
            android:id="@+id/progresoSesion"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="10dp"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:max="10"
            android:progress="1"
            android:progressDrawable="@drawable/progress_horizontal" />

        <TextView
            android:id="@+id/tvXpSesion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⭐ 0 XP"
            android:textColor="#FFD54F"
            android:textStyle="bold" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvContadorPregunta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="Pregunta 1 de 10"
        android:textColor="#8A93A6"
        android:textSize="13sp" />

    <!-- Anillo de tiempo restante -->
    <FrameLayout
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="18dp">

        <com.example.syslearning.ui.AnilloProgresoView
            android:id="@+id/anilloTiempo"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/tvTiempo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="20"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textSize="22sp" />

    </FrameLayout>

    <!-- Pregunta -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:cardCornerRadius="20dp"
        app:cardBackgroundColor="#1B2434"
        app:strokeWidth="0dp">

        <TextView
            android:id="@+id/tvEnunciado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp"
            android:text="¿Enunciado de la pregunta?"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Opciones -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOpcionA"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:text="Opción A"
        android:textAllCaps="false"
        android:textSize="16sp"
        app:cornerRadius="18dp"
        app:backgroundTint="#1E293B" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOpcionB"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:text="Opción B"
        android:textAllCaps="false"
        android:textSize="16sp"
        app:cornerRadius="18dp"
        app:backgroundTint="#1E293B" />

</LinearLayout>