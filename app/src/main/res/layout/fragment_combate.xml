<?xml version="1.0" encoding="utf-8"?>
<!-- Combate por turnos con preguntas (CombateFragment). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_juego"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/contenedorBatalla"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Barra superior: salir + indicador de turno -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/btnSalirCombate"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="Huir del combate"
                android:gravity="center"
                android:text="✕"
                android:textColor="@android:color/white"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/tvRonda"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Ronda 1"
                android:textColor="#B8C4D9"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvTurno"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_juego_chip"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp"
                android:text="🐶 Tu turno"
                android:textColor="#22E5FF"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Arena -->
        <FrameLayout
            android:id="@+id/arena"
            android:layout_width="match_parent"
            android:layout_height="250dp">

            <!-- Virus (arriba a la derecha) -->
            <LinearLayout
                android:layout_width="170dp"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="14dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNombreVirusCombate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/barraVidaVirus"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:layout_marginTop="4dp"
                    android:progressDrawable="@drawable/barra_vida_enemigo" />

                <TextView
                    android:id="@+id/tvVidaVirus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FF8A65"
                    android:textSize="11sp" />

                <ImageView
                    android:id="@+id/imgVirusCombate"
                    android:layout_width="104dp"
                    android:layout_height="104dp"
                    android:layout_marginTop="2dp"
                    android:contentDescription="Virus" />

            </LinearLayout>

            <!-- SYS-01 (abajo a la izquierda) -->
            <LinearLayout
                android:layout_width="190dp"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="12dp"
                android:layout_marginBottom="4dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/imgRobotCombate"
                    android:layout_width="150dp"
                    android:layout_height="122dp"
                    android:contentDescription="SYS-01"
                    android:src="@drawable/robot_sys01" />

                <ProgressBar
                    android:id="@+id/barraVidaRobot"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:progressDrawable="@drawable/barra_vida" />

                <TextView
                    android:id="@+id/tvVidaRobot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#69F0AE"
                    android:textSize="11sp" />

                <ProgressBar
                    android:id="@+id/barraEnergiaRobot"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="2dp"
                    android:progressDrawable="@drawable/barra_energia" />

                <TextView
                    android:id="@+id/tvEnergiaRobot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#22E5FF"
                    android:textSize="11sp" />

            </LinearLayout>

            <!-- Disparo láser de SYS-01 -->
            <View
                android:id="@+id/laser"
                android:layout_width="44dp"
                android:layout_height="8dp"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="150dp"
                android:layout_marginBottom="110dp"
                android:background="#22E5FF"
                android:visibility="invisible" />

            <!-- Números de daño flotantes -->
            <TextView
                android:id="@+id/tvDanoVirus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_marginTop="70dp"
                android:layout_marginEnd="70dp"
                android:shadowColor="#000000"
                android:shadowRadius="6"
                android:textColor="#FFD54F"
                android:textSize="26sp"
                android:textStyle="bold"
                android:visibility="invisible" />

            <TextView
                android:id="@+id/tvDanoRobot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="70dp"
                android:layout_marginBottom="120dp"
                android:shadowColor="#000000"
                android:shadowRadius="6"
                android:textColor="#FF5252"
                android:textSize="24sp"
                android:textStyle="bold"
                android:visibility="invisible" />

        </FrameLayout>

        <!-- Mensaje de respuesta correcta / incorrecta -->
        <TextView
            android:id="@+id/tvMensajeCombate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:gravity="center"
            android:minHeight="36dp"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Pregunta del turno -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_juego_tarjeta"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/tvPreguntaCombate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCodigoCombate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="#050B1F"
                        android:fontFamily="monospace"
                        android:padding="10dp"
                        android:textColor="#E2E8F0"
                        android:textSize="13sp"
                        android:visibility="gone" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/contenedorOpcionesCombate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPulsoEmp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="⚡ Activar Pulso EMP (30 de energía): daño ×2"
                    android:textAllCaps="false"
                    android:textColor="#22E5FF"
                    android:visibility="gone"
                    app:cornerRadius="20dp"
                    app:strokeColor="#22E5FF" />

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

    <!-- Pantalla de victoria o derrota -->
    <LinearLayout
        android:id="@+id/pantallaResultado"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6050B1F"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/imgResultado"
            android:layout_width="180dp"
            android:layout_height="148dp"
            android:contentDescription="Resultado del combate" />

        <TextView
            android:id="@+id/tvTituloResultado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/bungee"
            android:textColor="#22E5FF"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/tvDetalleResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:textColor="@android:color/white"
            android:textSize="15sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVolverSysRobotResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:minHeight="52dp"
            android:text="Volver a SYS ROBOT"
            android:textAllCaps="false"
            android:textColor="#050B1F"
            android:textSize="16sp"
            app:backgroundTint="#22E5FF"
            app:cornerRadius="26dp" />

    </LinearLayout>

</FrameLayout>
